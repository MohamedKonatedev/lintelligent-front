# Copier vers /etc/lintelligent/youtube-sync.env sur le VPS.
# Ne pas committer le fichier réel. Ne pas le placer dans le dépôt ni dans l'image Docker.
# chmod 600 et propriétaire = utilisateur système yt-sync.

# Clé API YouTube Data v3, restreinte à l'IP du VPS et à l'API YouTube Data.
YOUTUBE_API_KEY=

# Chaîne officielle @LintelligentTV. Ne pas changer sans vérification du customUrl.
YOUTUBE_CHANNEL_ID=UC23vhsEy8dqmxPV1bC6r7uQ

# Origine du CMS, sans /wp-json.
WP_BASE_URL=https://cms.lintelligent.tv

# Compte WordPress dédié, rôle « Sync YouTube », mot de passe d'application.
WP_USER=
WP_APP_PASSWORD=

# État local (repère anti-historique et identifiants déjà créés). Hors dépôt.
YT_SYNC_STATE_DIR=/var/lib/lintelligent-yt-sync

# Fuseau utilisé pour acf.date_diffusion (format Ymd).
YT_SYNC_TIMEZONE=Africa/Abidjan

# Rester à 0 jusqu'à la validation. Le timer peut être installé : --apply refusera d'écrire.
YT_SYNC_ENABLED=0

# Plafond de créations par passage. Le reliquat est repris 10 minutes plus tard.
YT_SYNC_MAX_PER_RUN=5
